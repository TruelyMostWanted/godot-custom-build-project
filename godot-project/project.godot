; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Custom Build Project"
config/description="Feature checks of the custom engine truelymostwanted-godot-engine, in GDScript and C#."
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://16-feature-audio-settings/resources/bus_layout.tres"

[dotnet]

project/assembly_name="GodotCustomBuildProject"

[filesystem]

streaming_assets/enabled=true
streaming_assets/source_folder="res://88-feature-streaming-assets-server/resources/streaming_assets"

