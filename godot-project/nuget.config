<?xml version="1.0" encoding="utf-8"?>
<!-- The Godot packages of the custom engine come from the local folder only, everything else from nuget.org.
     The path is relative to this file: P:/Projects/GitHub/nuget-local -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="truely-local" value="../../nuget-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="truely-local">
      <package pattern="Godot.NET.Sdk" />
      <package pattern="Godot.SourceGenerators" />
      <package pattern="GodotSharp" />
      <package pattern="GodotSharpEditor" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
