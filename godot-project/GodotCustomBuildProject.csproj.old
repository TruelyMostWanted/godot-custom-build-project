<!-- Godot.NET.Sdk comes from the local NuGet folder (nuget.config), built from truely-godot-engine with
     modules/mono/build_scripts/build_assemblies.py and its push-nupkgs-local option. The version follows version.py of the engine
     ("4.8.0-beta"; with GODOT_VERSION_STATUS=truely it is "4.8.0-truely"). -->
<Project Sdk="Godot.NET.Sdk/4.8.0-beta">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>TruelyInteractive</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
