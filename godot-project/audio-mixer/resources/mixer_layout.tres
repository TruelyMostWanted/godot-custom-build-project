[gd_resource type="AudioMixerLayout" format=3]

[sub_resource type="AudioMixerChannel" id="AudioMixerChannel_cd3ii"]
channel_name = &"music"
queue_mode = 1
default_fade_time = 0.3

[sub_resource type="AudioMixerChannel" id="AudioMixerChannel_jo76v"]
channel_name = &"ambience"
pause_with_tree = true
stop_on_scene_change = true

[sub_resource type="AudioMixerChannel" id="AudioMixerChannel_6jyej"]
channel_name = &"sfx"
max_polyphony = 8

[resource]
channels = Array[AudioMixerChannel]([SubResource("AudioMixerChannel_cd3ii"), SubResource("AudioMixerChannel_jo76v"), SubResource("AudioMixerChannel_6jyej")])
